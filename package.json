{
  "name": "job-match-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Full-stack agent that answers questions about a candidate's background and assesses fit against a job posting (PDF, image, or text).",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p src/client/tsconfig.json",
    "test": "node --env-file-if-exists=.env --test --experimental-test-module-mocks --import tsx 'src/**/__tests__/*.test.ts'",
    "test:file": "node --env-file-if-exists=.env --test --experimental-test-module-mocks --import tsx"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  }
}
